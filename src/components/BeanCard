export default function BeanCard({
  bean,
  setActiveBean,
  setView,
  Tag
}) {
  return (
    <div
      onClick={() => {
        setActiveBean(bean);
        setView("beanDetail");
      }}
      style={{
        background: "rgba(255,255,255,0.02)",
        border: "1px solid rgba(200,137,58,0.18)",
        borderRadius: "14px",
        padding: "16px 18px",
        cursor: "pointer",
        transition: "all 0.18s"
      }}
      onMouseEnter={e => {
        e.currentTarget.style.background = "rgba(200,137,58,0.06)";
        e.currentTarget.style.borderColor = "rgba(200,137,58,0.4)";
      }}
      onMouseLeave={e => {
        e.currentTarget.style.background = "rgba(255,255,255,0.02)";
        e.currentTarget.style.borderColor = "rgba(200,137,58,0.18)";
      }}
    >
      {/* Header */}
      <div style={{
        display: "flex",
        justifyContent: "space-between",
        alignItems: "flex-start",
        marginBottom: "10px"
      }}>
        <div>
          <div style={{
            fontFamily: "'Playfair Display', serif",
            fontSize: "18px",
            marginBottom: "3px"
          }}>
            {bean.name}
          </div>

          <div style={{
            fontSize: "12px",
            color: "#6a5040"
          }}>
            {[bean.roaster, bean.origin].filter(Boolean).join(" · ")}
          </div>
        </div>

        {bean.type && (
          <Tag>{bean.type}</Tag>
        )}
      </div>

      {/* Meta tags */}
      <div style={{
        display: "flex",
        gap: "6px",
        flexWrap: "wrap",
        marginBottom: "10px"
      }}>
        {bean.process && <Tag>{bean.process}</Tag>}
        {bean.roastLevel && <Tag>{bean.roastLevel}</Tag>}
        {bean.varietal && <Tag>{bean.varietal}</Tag>}
      </div>

      {/* Notes */}
      {bean.notes && (
        <div style={{
          fontSize: "12px",
          color: "#7a6050",
          lineHeight: 1.6,
          fontStyle: "italic",
          marginBottom: "10px"
        }}>
          "{bean.notes.slice(0, 120)}
          {bean.notes.length > 120 ? "…" : ""}"
        </div>
      )}

      {/* Footer */}
      <div style={{
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        marginTop: "10px"
      }}>
        <div style={{
          fontSize: "11px",
          color: "#4a3a2a"
        }}>
          {bean.brews?.length || 0} brew
          {(bean.brews?.length || 0) !== 1 ? "s" : ""}
        </div>

        {bean.roastDate && (
          <div style={{
            fontSize: "11px",
            color: "#5a4030"
          }}>
            Roasted {bean.roastDate}
          </div>
        )}
      </div>
    </div>
  );
}
